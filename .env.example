# Copy to .env and fill in. NEVER commit .env. See docs/CONTRACTS.md section 5.

# --- Meta Model API (B) ---
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
# Confirm the exact model id on dev.meta.ai (blog example used muse-spark-1.1)
MUSE_MODEL=muse-spark-1.3
# native = send the video directly; frames = ffmpeg frames at 2 fps (always works)
MUSE_VIDEO_MODE=frames
SAM_MODEL=

# --- WhatsApp Cloud API (A) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BOT_NUMBER=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0
PUBLIC_BASE_URL=http://localhost:8000

# --- Modes ---
# 1 = every verify/negotiate call returns fixtures (no API keys needed)
TIREKICK_FAKE_AI=1
# 1 = enable POST /dev/simulate and log outgoing WhatsApp messages instead of failing without a token
TIREKICK_DEV=1
